{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi extension collection: /exit, /plan, ...",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./packages/exit/index.ts",
      "./packages/plan-mode/index.ts",
      "./packages/web-fetch/index.ts",
      "./packages/code-search/index.ts",
      "./packages/subagents/index.ts",
      "./packages/footer/index.ts"
    ],
    "prompts": ["./prompts/upgrade.md"]
  },
  "scripts": {
    "check": "tsc --noEmit && node --test 'packages/**/*.test.mjs'",
    "test": "node --test 'packages/**/*.test.mjs'"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typebox": "^1.3.16",
    "typescript": "^5.7.0"
  }
}
