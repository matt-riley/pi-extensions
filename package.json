{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Personal pi extension collection: /exit, /plan, ...",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-conventions.mjs && tsc --noEmit && oxlint --deny-warnings . && oxfmt --check . && knip && fallow dead-code && node --test 'packages/**/*.test.mjs' 'scripts/**/*.test.mjs'",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "fallow": "fallow dead-code",
    "fallow:report": "fallow",
    "test": "node --test 'packages/**/*.test.mjs' 'scripts/**/*.test.mjs'",
    "verify": "node scripts/verify-tools.mjs",
    "collisions": "node packages/skill-select/collisions.mjs",
    "conventions": "node scripts/check-conventions.mjs",
    "smoke": "node scripts/smoke-pi.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fallow": "^3.27.0",
    "knip": "^6.37.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.83.0",
    "typebox": "^1.3.16",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./packages/exit/index.ts",
      "./packages/plan-mode/index.ts",
      "./packages/web-fetch/index.ts",
      "./packages/code-search/index.ts",
      "./packages/typesafe/index.ts",
      "./packages/skill-select/index.ts",
      "./packages/guardrail/index.ts",
      "./packages/router/index.ts",
      "./packages/prompt-coach/index.ts",
      "./packages/influencer/index.ts",
      "./packages/diagnosis-nudge/index.ts",
      "./packages/done-gate/index.ts",
      "./packages/until/index.ts",
      "./packages/subagents/index.ts",
      "./packages/footer/index.ts",
      "./packages/safe-compact/index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
