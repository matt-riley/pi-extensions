{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Extensions for the Pi coding agent: plan changes, explore code, run background jobs, and keep track of the work.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-conventions.mjs && npm run lint:comments && tsc --noEmit && oxlint --deny-warnings --report-unused-disable-directives . && oxfmt --check . && knip && fallow dead-code && node --test 'packages/**/*.test.mjs' 'scripts/**/*.test.mjs' 'shared/**/*.test.mjs'",
    "lint": "npm run lint:comments && oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:comments": "tsc --allowJs --checkJs --noEmit --strict --esModuleInterop --skipLibCheck --target es2022 --module nodenext scripts/comment-lint.mjs && node scripts/comment-lint.mjs",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "fallow": "fallow dead-code",
    "fallow:report": "fallow",
    "test": "node --test 'packages/**/*.test.mjs' 'scripts/**/*.test.mjs' 'shared/**/*.test.mjs'",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include='packages/**/*.mjs' --test-coverage-include='packages/*/index.ts' --test-coverage-include='scripts/*.mjs' --test-coverage-include='scripts/lib/*.mjs' --test-coverage-include='shared/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'packages/**/*.test.mjs' 'scripts/**/*.test.mjs' 'shared/**/*.test.mjs' scripts/verify-tools.mjs scripts/smoke-pi.mjs",
    "verify": "node scripts/verify-tools.mjs",
    "collisions": "node packages/skill-select/collisions.mjs",
    "conventions": "node scripts/check-conventions.mjs",
    "smoke": "node scripts/smoke-pi.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fallow": "^3.27.0",
    "knip": "^6.37.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.83.0",
    "typebox": "^1.3.16",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./packages/exit/index.ts",
      "./packages/plan-mode/index.ts",
      "./packages/web-fetch/index.ts",
      "./packages/code-search/index.ts",
      "./packages/guardrail/index.ts",
      "./packages/typesafe/index.ts",
      "./packages/skill-select/index.ts",
      "./packages/router/index.ts",
      "./packages/prompt-coach/index.ts",
      "./packages/diagnosis-nudge/index.ts",
      "./packages/done-gate/index.ts",
      "./packages/deslop/index.ts",
      "./packages/until/index.ts",
      "./packages/subagents/index.ts",
      "./packages/footer/index.ts",
      "./packages/toasts/index.ts",
      "./packages/decision-rows/index.ts",
      "./packages/drift/index.ts",
      "./packages/emphasis/index.ts",
      "./packages/safe-compact/index.ts",
      "./packages/review/index.ts",
      "./packages/watch-pr/index.ts",
      "./packages/workbench/index.ts",
      "./packages/jobs/index.ts",
      "./packages/doctor/index.ts",
      "./packages/architecture/index.ts",
      "./packages/affected/index.ts",
      "./packages/docs-drift/index.ts",
      "./packages/agents/index.ts",
      "./packages/quality/index.ts",
      "./packages/trail/index.ts"
    ],
    "skills": [
      "./.agents/skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
