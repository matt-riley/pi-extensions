#!/usr/bin/env node
// Isolated real-terminal acceptance. Requires pi, tmux, nvim and git on PATH.
// No personal configuration, credentials, external providers or session edits.
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { mkdtemp, mkdir, writeFile, readFile, rm } from "node:fs/promises";
import { createServer } from "node:http";
import { tmpdir } from "node:os";
import { stripVTControlCharacters } from "node:util";
import path from "node:path";

const root = path.resolve(import.meta.dirname, "..");
const fixture = await mkdtemp(path.join(tmpdir(), "pi-workbench-ui-"));
const cwd = path.join(fixture, "workspace");
const agent = path.join(fixture, "agent");
const socket = "pi-workbench-" + process.pid;
let footerPath = path.join(root, "packages/footer/index.ts");
const upgrade = process.argv.includes("--upgrade");
let requests = 0;
const server = createServer(async (req, res) => {
  for await (const _chunk of req) {
    /* Drain the request; never log prompts. */
  }
  requests++;
  await new Promise((resolve) => setTimeout(resolve, 1200));
  res.writeHead(200, { "content-type": "text/event-stream" });
  const chunk = (delta, finish_reason) => ({
    id: "ui-fixture",
    object: "chat.completion.chunk",
    created: 1,
    model: "fixture",
    choices: [{ index: 0, delta, finish_reason }],
  });
  res.write(
    "data: " +
      JSON.stringify(chunk({ role: "assistant", content: "UI_FIXTURE_OK" }, null)) +
      "\n\n",
  );
  res.write("data: " + JSON.stringify(chunk({}, "stop")) + "\n\n");
  res.end("data: [DONE]\n\n");
});
const delay = () => new Promise((resolve) => setTimeout(resolve, 40));
const tmux = (...args) =>
  execFileSync("tmux", ["-L", socket, ...args], {
    encoding: "utf8",
    timeout: 10000,
    stdio: ["ignore", "pipe", "pipe"],
  });
const screen = () => tmux("capture-pane", "-p", "-t", "ui");
const send = (text) => tmux("send-keys", "-t", "ui", "-l", text);
const key = (...keys) => tmux("send-keys", "-t", "ui", ...keys);
const shortcut = (letter) => send(String.fromCharCode(27) + "[" + letter.charCodeAt(0) + ";7u");
async function waitFor(pattern) {
  for (let i = 0; i < 150; i++) {
    const text = screen();
    if (pattern.test(text)) return text;
    await delay();
  }
  throw new Error(
    "UI did not show " + pattern + "\n" + tmux("capture-pane", "-p", "-t", "ui", "-S", "-300"),
  );
}
async function command(text) {
  key("C-u");
  send(text);
  key("Enter");
  await delay();
}
const git = (...args) =>
  execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", timeout: 10000 });

try {
  for (const binary of ["pi", "tmux", "nvim", "git"])
    execFileSync(binary, [binary === "tmux" ? "-V" : "--version"], {
      stdio: "pipe",
      timeout: 10000,
    });
  await mkdir(cwd);
  await mkdir(agent);
  await writeFile(path.join(cwd, ".gitignore"), "ignored.txt\n");
  await writeFile(path.join(cwd, "tracked name.txt"), "base-version\n");
  git("init", "-q");
  git("add", ".");
  git(
    "-c",
    "commit.gpgsign=false",
    "-c",
    "user.name=Fixture",
    "-c",
    "user.email=fixture@example.invalid",
    "commit",
    "-qm",
    "test: seed UI fixture",
  );
  await writeFile(path.join(cwd, "tracked name.txt"), "index-version\n");
  git("add", ".");
  await writeFile(path.join(cwd, "tracked name.txt"), "worktree-version\n");
  await writeFile(path.join(cwd, "工作.txt"), "unicode\n");
  await writeFile(path.join(cwd, "ignored.txt"), "not for the picker\n");
  const originalIndex = await readFile(path.join(cwd, ".git", "index"));
  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
  await writeFile(
    path.join(agent, "models.json"),
    JSON.stringify({
      providers: {
        "ui-local": {
          baseUrl: "http://127.0.0.1:" + server.address().port + "/v1",
          api: "openai-completions",
          apiKey: "fixture",
          models: [
            {
              id: "fixture",
              name: "Offline UI fixture",
              input: ["text"],
              contextWindow: 100000,
              maxTokens: 100,
              cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            },
          ],
        },
      },
    }),
  );
  await writeFile(
    path.join(agent, "settings.json"),
    JSON.stringify({
      quietStartup: true,
      retry: { enabled: false },
      compaction: { enabled: false },
      externalEditor: "nvim",
    }),
  );
  const mode = process.argv.includes("--regular") ? "regular" : "fullscreen";
  if (upgrade) {
    const target = path.join(fixture, "footer");
    await mkdir(target);
    const prior = execFileSync("git", ["ls-tree", "--name-only", "HEAD", "packages/footer/"], {
      cwd: root,
      encoding: "utf8",
    });
    for (const file of prior
      .trim()
      .split("\n")
      .filter((file) => /\.(ts|mjs)$/.test(file))) {
      await writeFile(
        path.join(target, path.basename(file)),
        execFileSync("git", ["show", "HEAD:" + file], { cwd: root }),
      );
    }
    footerPath = path.join(target, "index.ts");
  }
  tmux(
    "new-session",
    "-d",
    "-s",
    "ui",
    "-x",
    "100",
    "-y",
    "38",
    "-c",
    cwd,
    "/usr/bin/env",
    "-i",
    "PATH=" + process.env.PATH,
    "HOME=" + fixture,
    "XDG_CONFIG_HOME=" + fixture,
    "TERM=xterm-256color",
    "PI_CODING_AGENT_DIR=" + agent,
    "PI_CODING_AGENT_SESSION_DIR=" + path.join(fixture, "sessions"),
    "PI_OFFLINE=1",
    "PI_TELEMETRY=0",
    "pi",
    "--offline",
    "--no-extensions",
    "--no-mcp",
    "--no-context-files",
    "--no-skills",
    "--no-prompt-templates",
    "--no-themes",
    "--no-approve",
    "--provider",
    "ui-local",
    "--model",
    "fixture",
    "--thinking",
    "off",
    "--tui-mode",
    mode,
    "-e",
    path.join(root, "packages/workbench/index.ts"),
    "-e",
    footerPath,
  );
  if (upgrade) {
    tmux("pipe-pane", "-t", "ui", "-o", "cat > '" + path.join(fixture, "terminal.log") + "'");
    await waitFor(/fixture/);
    for (const name of ["index.ts", "workspace.mjs"]) {
      await writeFile(
        path.join(path.dirname(footerPath), name),
        await readFile(path.join(root, "packages/footer", name)),
      );
    }
    await command("/reload");
  }
  await waitFor(/ready/);
  if (upgrade) console.log("ok: prior HEAD footer upgrades through actual /reload");

  send("draft KEEP_ME");
  shortcut("k");
  await waitFor(/Command centre/);
  key("Escape");
  await waitFor(/draft KEEP_ME/);
  shortcut("k");
  await waitFor(/Command centre/);
  key("Enter"); // Search is the first group entry.
  await waitFor(/Search commands by name or intent/);
  send("previous conversation");
  key("Enter");
  await waitFor(/Resume a session/);
  key("Enter");
  await waitFor(/Prepared \/resume/);
  assert.match(screen(), /draft saved/);
  key("Enter"); // Execute the built-in through the normal editor, not a model.
  await waitFor(/sessions|Sessions|session/);
  key("Escape");
  await command("/reload");
  await waitFor(/draft saved/);
  await command("/ui restore");
  await waitFor(/draft KEEP_ME/);
  console.log(
    "ok: command groups, intent search, cancellation, built-in preparation and draft recovery",
  );

  shortcut("f");
  const filesScreen = await waitFor(/Project files/);
  assert.doesNotMatch(filesScreen, /ignored.txt/);
  key("Down", "Enter"); // Sorted inventory: .gitignore, tracked name.txt, 工作.txt.
  await waitFor(/draft KEEP_ME "tracked name.txt"/);
  console.log("ok: native file picker preserves draft and inserts a reference, not contents");

  await command("/changes tracked");
  await waitFor(/\[staged\]/);
  key("Enter");
  await waitFor(/Preview diff/);
  key("Enter");
  const staged = await waitFor(/\+index-version/);
  assert.doesNotMatch(staged, /\+worktree-version/);
  key("Escape");
  await waitFor(/Changes — read-only/);
  key("Down", "Enter");
  await waitFor(/Preview diff/);
  key("Enter");
  await waitFor(/\+worktree-version/);
  key("Escape");
  await waitFor(/Changes — read-only/);
  key("Enter");
  await waitFor(/Open in Neovim/);
  key("Down", "Enter");
  await waitFor(/readonly|\[RO\]/i);
  send(":q!");
  key("Enter");
  await waitFor(/Changes — read-only/);
  key("Escape");
  assert.deepEqual(await readFile(path.join(cwd, ".git", "index")), originalIndex);
  assert.equal(await readFile(path.join(cwd, "tracked name.txt"), "utf8"), "worktree-version\n");
  assert.equal(requests, 0, "Workbench navigation must not send prompts to a model");
  console.log(
    "ok: staged/unstaged scratch diffs, actual read-only Neovim handoff and TUI restoration; no file/index/model changes",
  );

  tmux("resize-window", "-t", "ui", "-x", "36", "-y", "24");
  await waitFor(/ready/);
  await command("/files 工作");
  await waitFor(/工作/);
  key("Enter");
  await waitFor(/"工作.txt"/);
  key("C-u");
  tmux("resize-window", "-t", "ui", "-x", "100", "-y", "38");
  await command("Hello offline fixture");
  await waitFor(/working/);
  await waitFor(/UI_FIXTURE_OK/);
  await waitFor(/ready/);
  assert.equal(requests, 1);
  console.log(
    "ok: narrow resize, Unicode file reference, actual working → ready lifecycle (" + mode + ")",
  );
  console.log(
    "Local real-TUI acceptance passed at HEAD " +
      execFileSync("git", ["rev-parse", "--short", "HEAD"], {
        cwd: root,
        encoding: "utf8",
      }).trim() +
      " plus working tree.",
  );
} catch (error) {
  if (upgrade) {
    console.error(
      "Terminal process: " +
        tmux("display-message", "-p", "-t", "ui", "#{pane_current_command} #{pane_pid}"),
    );
    console.error(
      stripVTControlCharacters(
        await readFile(path.join(fixture, "terminal.log"), "utf8").catch(() => ""),
      ),
    );
  }
  throw error;
} finally {
  try {
    tmux("kill-server");
  } catch {
    /* Server may already have exited. */
  }
  await new Promise((resolve) => server.close(resolve));
  await rm(fixture, { recursive: true, force: true });
}
